<devicedata>
  <name>SmartBuildOS Solar Position</name>
  <version></version>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>Solar Position</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>11/09/2026 12:00 PM</created>
  <modified></modified>
  <combo>true</combo>
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>IS_DAYLIGHT</name>
      <type>BOOL</type>
      <condition_statement>The sun is up</condition_statement>
      <description>NAME STRING</description>
      <true_text>has the sun up</true_text>
      <false_text>has the sun down</false_text>
    </conditional>
    <conditional>
      <id>2</id>
      <name>IS_GOLDEN_HOUR</name>
      <type>BOOL</type>
      <condition_statement>It is golden hour</condition_statement>
      <description>NAME STRING</description>
      <true_text>is in golden hour</true_text>
      <false_text>is not in golden hour</false_text>
    </conditional>
    <conditional>
      <id>7</id>
      <name>IS_NIGHT</name>
      <type>BOOL</type>
      <condition_statement>It is night</condition_statement>
      <description>NAME STRING</description>
      <true_text>is in night (twilight is over)</true_text>
      <false_text>is not in night</false_text>
    </conditional>
    <conditional>
      <id>3</id>
      <name>SUN_ON_FACADE_1</name>
      <type>BOOL</type>
      <condition_statement>The sun is on facade 1</condition_statement>
      <description>NAME STRING</description>
      <true_text>has sun on facade 1</true_text>
      <false_text>has no sun on facade 1</false_text>
    </conditional>
    <conditional>
      <id>4</id>
      <name>SUN_ON_FACADE_2</name>
      <type>BOOL</type>
      <condition_statement>The sun is on facade 2</condition_statement>
      <description>NAME STRING</description>
      <true_text>has sun on facade 2</true_text>
      <false_text>has no sun on facade 2</false_text>
    </conditional>
    <conditional>
      <id>5</id>
      <name>SUN_ON_FACADE_3</name>
      <type>BOOL</type>
      <condition_statement>The sun is on facade 3</condition_statement>
      <description>NAME STRING</description>
      <true_text>has sun on facade 3</true_text>
      <false_text>has no sun on facade 3</false_text>
    </conditional>
    <conditional>
      <id>6</id>
      <name>SUN_ON_FACADE_4</name>
      <type>BOOL</type>
      <condition_statement>The sun is on facade 4</condition_statement>
      <description>NAME STRING</description>
      <true_text>has sun on facade 4</true_text>
      <false_text>has no sun on facade 4</false_text>
    </conditional>
  </conditionals>
  <variables>
    <variable><id>3000</id><name>SUN_ELEVATION</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3001</id><name>SUN_AZIMUTH</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3002</id><name>IS_DAYLIGHT</name><type>BOOL</type><default>false</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3003</id><name>DAY_PHASE</name><type>STRING</type><default>unknown</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3004</id><name>NEXT_SUNRISE</name><type>STRING</type><default></default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3005</id><name>NEXT_SUNSET</name><type>STRING</type><default></default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3006</id><name>MINUTES_TO_SUNSET</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3007</id><name>MINUTES_TO_SUNRISE</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3008</id><name>SUN_ON_FACADE_1</name><type>BOOL</type><default>false</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3009</id><name>SUN_ON_FACADE_2</name><type>BOOL</type><default>false</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3010</id><name>SUN_ON_FACADE_3</name><type>BOOL</type><default>false</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3011</id><name>SUN_ON_FACADE_4</name><type>BOOL</type><default>false</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3012</id><name>LOCATION_SOURCE</name><type>STRING</type><default>none</default><readonly>true</readonly><hidden>false</hidden></variable>
  </variables>
  <events>
    <event><id>1</id><name>Golden Hour Started</name><description>The sun entered golden hour (between the horizon and 6 degrees), morning or evening: fires at sunrise and again when the evening golden hour starts</description></event>
    <event><id>2</id><name>Civil Dawn</name><description>First light: the sun rose above -6 degrees and civil twilight began, before sunrise</description></event>
    <event><id>3</id><name>Civil Dusk</name><description>The sun set below the horizon into civil twilight in the evening (the same moment as Sunset)</description></event>
    <event><id>4</id><name>Sun Hits Facade 1</name><description>The sun started shining on facade 1</description></event>
    <event><id>5</id><name>Sun Leaves Facade 1</name><description>The sun stopped shining on facade 1</description></event>
    <event><id>6</id><name>Sun Hits Facade 2</name><description>The sun started shining on facade 2</description></event>
    <event><id>7</id><name>Sun Leaves Facade 2</name><description>The sun stopped shining on facade 2</description></event>
    <event><id>8</id><name>Sun Hits Facade 3</name><description>The sun started shining on facade 3</description></event>
    <event><id>9</id><name>Sun Leaves Facade 3</name><description>The sun stopped shining on facade 3</description></event>
    <event><id>10</id><name>Sun Hits Facade 4</name><description>The sun started shining on facade 4</description></event>
    <event><id>11</id><name>Sun Leaves Facade 4</name><description>The sun stopped shining on facade 4</description></event>
    <event><id>12</id><name>Location Changed</name><description>The site coordinates changed (project or manual) and the sun was recomputed</description></event>
    <event><id>13</id><name>Sunrise</name><description>The sun rose above the horizon</description></event>
    <event><id>14</id><name>Sunset</name><description>The sun set below the horizon</description></event>
    <event><id>15</id><name>Night Began</name><description>Evening twilight ended (the sun is 6 degrees below the horizon): it is dark</description></event>
    <event><id>16</id><name>Evening Golden Hour Started</name><description>The evening sun dropped under 6 degrees: low, warm light until sunset</description></event>
    <event><id>17</id><name>Morning Golden Hour Ended</name><description>The morning sun climbed above 6 degrees: full daylight</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"></script>
    <documentation file="www/documentation/index.html"></documentation>
    <actions>
      <action><name>Print Solar Status</name><command>PRINT_STATUS</command></action>
      <action><name>Recompute Now</name><command>RECOMPUTE</command></action>
      <action><name>Rediscover Location</name><command>REDISCOVER_LOCATION</command></action>
      <action><name>Register With Agent Now</name><command>REGISTER_NOW</command></action>
      <action><name>Refresh Status</name><command>REFRESH_STATUS</command></action>
    </actions>
    <commands>
      <command>
        <name>RECOMPUTE_SUN</name>
        <description>Recompute the sun position and facade states now (also runs every minute)</description>
        <params></params>
      </command>
    </commands>
    <properties>
      <property><name>Driver Status</name><type>STRING</type><default>Starting</default><readonly>true</readonly></property>
      <property><name>Driver Version</name><type>STRING</type><default></default><readonly>true</readonly></property>
      <property><name>License Status</name><type>STRING</type><default>No SmartBuildOS Agent Found</default><readonly>true</readonly></property>
      <property><name>License Source</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Subscription Tier</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>SmartBuildOS Company</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Solar Status</name><type>STRING</type><default>starting</default><readonly>true</readonly></property>
      <property><name>Location</name><type>STRING</type><default>unresolved</default><readonly>true</readonly></property>
      <property><name>Sun Now</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Today</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Facade Status</name><type>STRING</type><default>no facades configured</default><readonly>true</readonly></property>
      <property><name>Last Solar Error</name><type>STRING</type><default>none</default><readonly>true</readonly></property>
      <property><name>Location Source</name><type>LIST</type><items><item>Control4 Project</item><item>Manual Coordinates</item></items><default>Control4 Project</default><description>Control4 Project reads the latitude and longitude from the project (System Design → project properties). Manual Coordinates uses the two fields below.</description></property>
      <property><name>Latitude</name><type>STRING</type><default></default></property>
      <property><name>Longitude</name><type>STRING</type><default></default></property>
      <property><name>Facade 1 Name</name><type>STRING</type><default></default><description>A name turns the facade on. Empty = not used.</description></property>
      <property><name>Facade 1 Azimuth</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>359</maximum><default>180</default><description>Faces: 0 N, 90 E, 180 S, 270 W (true north).</description></property>
      <property><name>Facade 1 Width</name><type>RANGED_INTEGER</type><minimum>10</minimum><maximum>180</maximum><default>90</default><description>Degrees of sky it sees, centred on the heading.</description></property>
      <property><name>Facade 1 Min Elevation</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>60</maximum><default>5</default><description>Lowest sun that counts. Raise to clear trees.</description></property>
      <property><name>Facade 1 Max Elevation</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>90</maximum><default>90</default><description>Highest sun that counts. 90 = no limit.</description></property>
      <property><name>Facade 2 Name</name><type>STRING</type><default></default></property>
      <property><name>Facade 2 Azimuth</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>359</maximum><default>90</default></property>
      <property><name>Facade 2 Width</name><type>RANGED_INTEGER</type><minimum>10</minimum><maximum>180</maximum><default>90</default></property>
      <property><name>Facade 2 Min Elevation</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>60</maximum><default>5</default></property>
      <property><name>Facade 2 Max Elevation</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>90</maximum><default>90</default></property>
      <property><name>Facade 3 Name</name><type>STRING</type><default></default></property>
      <property><name>Facade 3 Azimuth</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>359</maximum><default>270</default></property>
      <property><name>Facade 3 Width</name><type>RANGED_INTEGER</type><minimum>10</minimum><maximum>180</maximum><default>90</default></property>
      <property><name>Facade 3 Min Elevation</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>60</maximum><default>5</default></property>
      <property><name>Facade 3 Max Elevation</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>90</maximum><default>90</default></property>
      <property><name>Facade 4 Name</name><type>STRING</type><default></default></property>
      <property><name>Facade 4 Azimuth</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>359</maximum><default>0</default></property>
      <property><name>Facade 4 Width</name><type>RANGED_INTEGER</type><minimum>10</minimum><maximum>180</maximum><default>90</default></property>
      <property><name>Facade 4 Min Elevation</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>60</maximum><default>5</default></property>
      <property><name>Facade 4 Max Elevation</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>90</maximum><default>90</default></property>
      <property><name>Log Level</name><type>LIST</type><items><item>0 - Fatal</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Debug</item><item>5 - Trace</item></items><default>2 - Warning</default></property>
      <property><name>Log Mode</name><type>LIST</type><items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items><default>Off</default></property>
    </properties>
  </config>
  <proxies>
  </proxies>
  <capabilities>
  </capabilities>
  <connections>
  </connections>
</devicedata>
