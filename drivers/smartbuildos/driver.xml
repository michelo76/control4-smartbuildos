    <variable>
      <id>2004</id>
      <name>ISSUE_TEXT</name>
      <type>STRING</type>
      <default></default>
      <readonly>true</readonly>
      <hidden>false</hidden>
    </variable>
    <variable>
      <id>2005</id>
      <name>NOTICE_TEXT</name>
      <type>STRING</type>
      <default></default>
      <readonly>true</readonly>
      <hidden>false</hidden>
    </variable>
    <variable>
      <id>2006</id>
      <name>SYSTEM_STARTUPS_TODAY</name>
