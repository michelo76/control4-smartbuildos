<devicedata>
  <name>Bond Switch (SBOS)</name>
  <version/>
  <manufacturer>Olibra</manufacturer>
  <model>Bond Switch (SBOS)</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>08/30/2026 12:00:00 PM</created>
  <modified/>
  <minimum_os_version>3.2.0</minimum_os_version>
  <composer_categories>
    <category>Others</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>BOND_SWITCH_ON</name>
      <type>BOOL</type>
      <condition_statement>Switch power state</condition_statement>
      <description>NAME is STRING</description>
      <true_text>On</true_text>
      <false_text>Off</false_text>
    </conditional>
  </conditionals>
  <events>
    <event><id>1</id><name>Turned On</name><description>The device turned on.</description></event>
    <event><id>2</id><name>Turned Off</name><description>The device turned off.</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <actions>
      <action><name>Print Diagnostics To Log</name><command>PRINT_DIAGNOSTICS</command></action>
      <action><name>Refresh From Gateway</name><command>REFRESH_FROM_GATEWAY</command></action>
      <action><name>Forget Device</name><command>FORGET_DEVICE</command></action>
    </actions>
    <properties>
      <property>
        <name>Bond Device</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not bound</default>
        <description>Which Bond device this instance represents - bind the Bond Switch connection to the Bond Bridge Gateway.</description>
      </property>
      <property>
        <name>Gateway Link</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not bound - bind the Bond Switch connection to the Gateway</default>
      </property>
      <property>
        <name>Power</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Last Control</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Status</name>
        <type>LABEL</type>
        <default>Status</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Starting</default>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
      </property>
      <property>
        <name>Logging</name>
        <type>LABEL</type>
        <default>Logging</default>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
        <default>Off</default>
      </property>
    </properties>
    <commands>
      <command>
        <name>Turn On</name>
        <description>Turn the device on</description>
      </command>
      <command>
        <name>Turn Off</name>
        <description>Turn the device off</description>
      </command>
      <command>
        <name>Set Timer</name>
        <description>Turn the device off after SECONDS seconds (0 cancels)</description>
        <params>
          <param><name>Seconds</name><type>STRING</type></param>
        </params>
      </command>
    </commands>
  </config>
  <proxies>
    <proxy proxybindingid="5001" name="Bond Switch" image_source="c4z" large_image="icons/device_lg.png" small_image="icons/device_sm.png">uibutton</proxy>
  </proxies>
  <capabilities>
    <navigator_display_option proxybindingid="5001">
      <display_icons>
        <Icon width="70" height="70">controller://driver/bond-generic/icons/70x70/power-off.png</Icon>
        <Icon width="90" height="90">controller://driver/bond-generic/icons/90x90/power-off.png</Icon>
        <Icon width="300" height="300">controller://driver/bond-generic/icons/300x300/power-off.png</Icon>
        <state id="Off">
          <Icon width="70" height="70">controller://driver/bond-generic/icons/70x70/power-off.png</Icon>
          <Icon width="90" height="90">controller://driver/bond-generic/icons/90x90/power-off.png</Icon>
          <Icon width="300" height="300">controller://driver/bond-generic/icons/300x300/power-off.png</Icon>
        </state>
        <state id="On">
          <Icon width="70" height="70">controller://driver/bond-generic/icons/70x70/power-on.png</Icon>
          <Icon width="90" height="90">controller://driver/bond-generic/icons/90x90/power-on.png</Icon>
          <Icon width="300" height="300">controller://driver/bond-generic/icons/300x300/power-on.png</Icon>
        </state>
      </display_icons>
    </navigator_display_option>
  </capabilities>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Switch</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes><class><classname>UIBUTTON</classname></class></classes>
    </connection>
    <connection>
      <id>200</id>
      <facing>6</facing>
      <connectionname>Relay Control</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes><class><classname>RELAY</classname></class></classes>
    </connection>
    <connection>
      <id>300</id>
      <facing>6</facing>
      <connectionname>Toggle Button Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes><class><classname>BUTTON_LINK</classname></class></classes>
    </connection>
    <connection>
      <id>301</id>
      <facing>6</facing>
      <connectionname>On Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes><class><classname>BUTTON_LINK</classname></class></classes>
    </connection>
    <connection>
      <id>302</id>
      <facing>6</facing>
      <connectionname>Off Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes><class><classname>BUTTON_LINK</classname></class></classes>
    </connection>
    <connection>
      <id>1</id>
      <facing>6</facing>
      <connectionname>Bond Switch</connectionname>
      <type>1</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>SBOS_BOND_GENERIC</classname>
        </class>
      </classes>
    </connection>
  </connections>
</devicedata>
