<devicedata>
  <name>SmartBuildOS Mode Button</name>
  <version></version>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>Mode Button</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>08/29/2026 12:00 PM</created>
  <modified></modified>
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <events>
    <event><id>1</id><name>Pressed</name><description>The mode button was tapped in Navigator.</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"></script>
    <documentation file="www/documentation/index.html"></documentation>
    <actions>
      <action><name>Refresh From Mode Manager</name><command>REFRESH_STATE</command></action>
      <action><name>Print Diagnostics</name><command>PRINT_DIAGNOSTICS</command></action>
    </actions>
    <properties>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default>Starting</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default></default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Mode</name>
        <type>LIST</type>
        <items><item>-</item></items>
        <default>-</default>
        <readonly>false</readonly>
        <description>Which mode this Navigator button shows and activates. The list comes from the Mode Composer manager in this project.</description>
      </property>
      <property>
        <name>Mode Manager</name>
        <type>STRING</type>
        <default>Searching...</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Rename With Mode</name>
        <type>LIST</type>
        <items><item>Yes</item><item>No</item></items>
        <default>Yes</default>
        <readonly>false</readonly>
        <description>Rename this driver instance to the mode's name so Navigator shows the mode, not "Mode Button". Dealer renames are never overwritten.</description>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
        <default>3 - Info</default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
        <default>Off</default>
        <readonly>false</readonly>
      </property>
    </properties>
  </config>
  <proxies>
    <proxy proxybindingid="5001" name="Mode Button">uibutton</proxy>
  </proxies>
