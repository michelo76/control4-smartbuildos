<devicedata>
  <name>SmartBuildOS Event Tracer</name>
  <version></version>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>Event Tracer</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>11/08/2026 12:00 PM</created>
  <modified></modified>
  <combo>true</combo>
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>CAPTURE_ACTIVE</name>
      <type>BOOL</type>
      <condition_statement>Capture is active</condition_statement>
      <description>NAME is STRING</description>
      <true_text>capturing</true_text>
      <false_text>not capturing</false_text>
    </conditional>
    <conditional>
      <id>2</id>
      <name>AGENT_READY</name>
      <type>BOOL</type>
      <condition_statement>SmartBuildOS Agent link is ready</condition_statement>
      <description>NAME is STRING</description>
      <true_text>ready</true_text>
      <false_text>not ready</false_text>
    </conditional>
    <conditional>
      <id>3</id>
      <name>STORM_ACTIVE</name>
      <type>BOOL</type>
      <condition_statement>An event storm is in progress</condition_statement>
      <description>NAME STRING</description>
      <true_text>has an event storm</true_text>
      <false_text>has no event storm</false_text>
    </conditional>
  </conditionals>
  <variables>
    <variable><id>3000</id><name>CAPTURE_STATUS</name><type>STRING</type><default>starting</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3001</id><name>AGENT_CONNECTION</name><type>STRING</type><default>waiting_for_agent</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3002</id><name>SUBSCRIPTIONS</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3003</id><name>EVENTS_CAPTURED</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3004</id><name>ACTIVE_STORMS</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3005</id><name>LAST_EVENT</name><type>STRING</type><default></default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3006</id><name>LAST_EVENT_DEVICE</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3007</id><name>BUFFERED_EVENTS</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3008</id><name>DROPPED_EVENTS</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3009</id><name>LAST_CAPTURE_ERROR</name><type>STRING</type><default></default><readonly>true</readonly><hidden>false</hidden></variable>
  </variables>
  <events>
    <event><id>1</id><name>Capture Degraded</name><description>Capture lost the Agent, the licence or its budget (see Last Capture Error)</description></event>
    <event><id>2</id><name>Capture Restored</name><description>Capture is healthy again after a degraded period</description></event>
    <event><id>3</id><name>Event Storm Detected</name><description>One device fired the same event more than Storm Threshold times in a minute</description></event>
    <event><id>4</id><name>Event Storm Ended</name><description>A detected event storm stopped</description></event>
    <event><id>5</id><name>Agent Connected</name><description>The driver registered with the SmartBuildOS Agent</description></event>
    <event><id>6</id><name>Agent Disconnected</name><description>The driver lost its registration with the SmartBuildOS Agent</description></event>
    <event><id>7</id><name>Unknown Event Learned</name><description>A probe subscription received an event the catalogue did not list</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"></script>
    <documentation file="www/documentation/index.html"></documentation>
    <actions>
      <action><name>Print Recent Events</name><command>PRINT_RECENT</command></action>
      <action><name>Print Events For Inspect Device</name><command>PRINT_DEVICE</command></action>
      <action><name>Print Coverage</name><command>PRINT_COVERAGE</command></action>
      <action><name>Print Capture Status</name><command>PRINT_STATUS</command></action>
      <action><name>Re-apply Capture Now</name><command>REAPPLY</command></action>
      <action><name>Pause Capture</name><command>PAUSE_CAPTURE_ACTION</command></action>
      <action><name>Resume Capture</name><command>RESUME_CAPTURE_ACTION</command></action>
      <action><name>Register With Agent Now</name><command>REGISTER_NOW</command></action>
      <action><name>Refresh Status</name><command>REFRESH_STATUS</command></action>
      <action><name>Clear Local History</name><command>CLEAR_HISTORY</command></action>
      <action><name>Forget Learned Events</name><command>FORGET_LEARNED</command></action>
    </actions>
    <commands>
      <command>
        <name>MARK_TIMELINE</name>
        <description>Place a named marker in the event timeline (for example at the start of a routine)</description>
        <params>
          <param><name>NAME</name><type>STRING</type></param>
          <param><name>DETAIL</name><type>STRING</type></param>
          <param><name>DEVICE</name><type>DEVICE_SELECTOR</type></param>
        </params>
      </command>
      <command>
        <name>PAUSE_CAPTURE</name>
        <description>Pause capture (every event subscription is released)</description>
        <params>
          <param><name>REASON</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>RESUME_CAPTURE</name>
        <description>Resume capture (subscriptions are rebuilt from the project)</description>
        <params></params>
      </command>
    </commands>
    <properties>
      <property><name>Driver Status</name><type>STRING</type><default>Starting</default><readonly>true</readonly></property>
      <property><name>Driver Version</name><type>STRING</type><default></default><readonly>true</readonly></property>
      <property><name>Capture Status</name><type>STRING</type><default>starting</default><readonly>true</readonly></property>
      <property><name>Agent Link</name><type>STRING</type><default>Looking for the SmartBuildOS Agent</default><readonly>true</readonly></property>
      <property><name>Agent Connection</name><type>STRING</type><default>waiting_for_agent</default><readonly>true</readonly></property>
      <property><name>License Status</name><type>STRING</type><default>No SmartBuildOS Agent Found</default><readonly>true</readonly></property>
      <property><name>License Source</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Subscription Tier</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>SmartBuildOS Company</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Coverage</name><type>STRING</type><default>not applied yet</default><readonly>true</readonly></property>
      <property><name>Catalogue</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Events Captured</name><type>STRING</type><default>0</default><readonly>true</readonly></property>
      <property><name>Last Event</name><type>STRING</type><default>none yet</default><readonly>true</readonly></property>
      <property><name>Active Storms</name><type>STRING</type><default>none</default><readonly>true</readonly></property>
      <property><name>Buffered Events</name><type>STRING</type><default>0</default><readonly>true</readonly></property>
      <property><name>Dropped Events</name><type>STRING</type><default>0</default><readonly>true</readonly></property>
      <property><name>Last Upload</name><type>STRING</type><default>never</default><readonly>true</readonly></property>
      <property><name>Last Capture Error</name><type>STRING</type><default>none</default><readonly>true</readonly></property>
      <property><name>Capture</name><type>LIST</type><items><item>On</item><item>Off</item></items><default>On</default><description>Off releases every subscription; the local history is kept.</description></property>
      <property><name>Read Events From Project</name><type>LIST</type><items><item>On</item><item>Off</item></items><default>On</default><description>Also learn each device's events from the controller's project data (covers Control4's own drivers). Catalogue shows how many devices this found; Off relies on the built-in and learned catalogues only.</description></property>
      <property><name>Probe Unknown Drivers</name><type>LIST</type><items><item>Off</item><item>On</item></items><default>Off</default><description>Subscribe to event ids 1..Probe Range on devices whose driver is not catalogued. Events that arrive are learned and named "Event N" until the catalogue is updated.</description></property>
      <property><name>Probe Range</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>64</maximum><default>32</default></property>
      <property><name>Max Subscriptions</name><type>RANGED_INTEGER</type><minimum>50</minimum><maximum>2500</maximum><default>1000</default></property>
      <property><name>Storm Threshold</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>600</maximum><default>30</default></property>
      <property><name>Upload Budget</name><type>RANGED_INTEGER</type><minimum>10</minimum><maximum>1200</maximum><default>300</default></property>
      <property><name>Local History Size</name><type>RANGED_INTEGER</type><minimum>50</minimum><maximum>2000</maximum><default>500</default></property>
      <property><name>Exclude Device IDs</name><type>STRING</type><default></default></property>
      <property><name>Exclude Driver Files</name><type>STRING</type><default></default></property>
      <property><name>Inspect Device ID</name><type>STRING</type><default></default></property>
      <property><name>Buffer Warning Threshold</name><type>RANGED_INTEGER</type><minimum>50</minimum><maximum>300</maximum><default>200</default></property>
      <property><name>Log Level</name><type>LIST</type><items><item>0 - Fatal</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Debug</item><item>5 - Trace</item></items><default>2 - Warning</default></property>
      <property><name>Log Mode</name><type>LIST</type><items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items><default>Off</default></property>
    </properties>
  </config>
  <proxies>
  </proxies>
  <capabilities>
  </capabilities>
  <connections>
  </connections>
</devicedata>
