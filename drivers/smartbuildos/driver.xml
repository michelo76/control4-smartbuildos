<devicedata>
  <name>SmartBuildOS Connector</name>
  <version/>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>SmartBuildOS Connector</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>08/15/2026 12:00:00 PM</created>
  <modified/>
  <combo>true</combo>
  <minimum_os_version>3.3.1</minimum_os_version>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>SMARTBUILDOS_CONNECTED</name>
      <type>BOOL</type>
      <condition_statement>SmartBuildOS connection status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Connected</true_text>
      <false_text>Disconnected</false_text>
    </conditional>
    <conditional>
      <id>2</id>
      <name>SMARTBUILDOS_PAIRED</name>
      <type>BOOL</type>
      <condition_statement>SmartBuildOS pairing status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Paired</true_text>
      <false_text>Not paired</false_text>
    </conditional>
  </conditionals>
  <variables>
    <variable>
      <id>2000</id>
      <name>DIRECTOR_RELOADS</name>
      <type>NUMBER</type>
      <default>0</default>
      <readonly>true</readonly>
      <hidden>false</hidden>
    </variable>
    <variable>
      <id>2001</id>
      <name>LAST_RELOAD</name>
      <type>STRING</type>
      <default></default>
      <readonly>true</readonly>
      <hidden>false</hidden>
    </variable>
  </variables>
  <events>
    <event>
      <id>1</id>
      <name>Connected</name>
      <description>When NAME connects to SmartBuildOS</description>
    </event>
    <event>
      <id>2</id>
      <name>Disconnected</name>
      <description>When NAME loses its connection to SmartBuildOS</description>
    </event>
    <event>
      <id>3</id>
      <name>Sync Failed</name>
      <description>When NAME fails to deliver a payload to SmartBuildOS</description>
    </event>
    <event>
      <id>4</id>
      <name>Paired</name>
      <description>When NAME is successfully paired to a SmartBuildOS property</description>
    </event>
    <event>
      <id>5</id>
      <name>Device Went Offline</name>
      <description>When a device in this project goes offline</description>
    </event>
    <event>
      <id>6</id>
      <name>Device Came Online</name>
      <description>When a device in this project comes back online</description>
    </event>
    <event>
      <id>7</id>
      <name>Director Reloaded</name>
      <description>When Director comes back up under this driver — a controller reboot, a Director restart or a project reload. Deliberately NOT fired by a driver update, which restarts the driver without the controller having gone anywhere.</description>
    </event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <actions>
      <action>
        <name>Test Connection</name>
        <command>TEST_CONNECTION</command>
      </action>
      <action>
        <name>Poll Devices Now</name>
        <command>POLL_DEVICES</command>
      </action>
      <action>
        <name>Send Full Sync</name>
        <command>SEND_FULL_SYNC</command>
      </action>
      <action>
        <name>Send Heartbeat Now</name>
        <command>SEND_HEARTBEAT</command>
      </action>
      <action>
        <name>Scan Network Now</name>
        <command>SCAN_NETWORK</command>
      </action>
      <action>
        <name>Report Telemetry Survey</name>
        <command>REPORT_TELEMETRY_SURVEY</command>
      </action>
      <action>
        <name>Report Diagnostics</name>
        <command>REPORT_DIAGNOSTICS</command>
      </action>
      <action>
        <name>Probe Capabilities</name>
        <command>PROBE_CAPABILITIES</command>
      </action>
      <action>
        <name>Generate Touchpanel URL</name>
        <command>GENERATE_DISPLAY_URL</command>
      </action>
      <action>
        <name>Unpair</name>
        <command>UNPAIR</command>
      </action>
      <!-- #ifndef DRIVERCENTRAL -->
      <action>
        <name>Update Drivers</name>
        <command>UPDATE_DRIVERS</command>
      </action>
      <!-- #endif -->
    </actions>
    <commands>
      <command>
        <name>SEND_EVENT</name>
        <description>Send a named event to SmartBuildOS</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>DETAIL</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_STATE</name>
        <description>Report a named state to SmartBuildOS telemetry (e.g. Rack Door = OPEN)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>VALUE</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_MEASUREMENT</name>
        <description>Report a numeric measurement to SmartBuildOS telemetry (e.g. UPS Battery = 37 %)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>VALUE</name>
            <type>STRING</type>
          </param>
          <param>
            <name>UNIT</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_COUNTER</name>
        <description>Increment a named counter in SmartBuildOS telemetry (e.g. Garage Door Cycles)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_FAULT</name>
        <description>Report a fault to SmartBuildOS telemetry (e.g. Generator: Low battery)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>DETAIL</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_SERVICE_EVENT</name>
        <description>Report a service-relevant event to SmartBuildOS telemetry (e.g. Filter replaced)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>DETAIL</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
    </commands>
    <properties>
      <property>
        <name>Cloud</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <property>
        <name>Update Channel</name>
        <type>LIST</type>
        <default>Production</default>
        <items>
          <item>Production</item>
          <item>Prerelease</item>
        </items>
      </property>
      <property>
        <name>SmartBuildOS Settings</name>
        <type>LABEL</type>
        <default>SmartBuildOS Connection</default>
      </property>
      <property>
        <name>API URL</name>
        <type>STRING</type>
        <default>https://app.smartbuildos.io</default>
        <readonly>true</readonly>
        <description>SmartBuildOS endpoint this driver reports to. Fixed: a mistyped URL silently breaks pairing and every upload.</description>
      </property>
      <property>
        <name>Pairing Code</name>
        <type>STRING</type>
        <default/>
        <password>true</password>
        <description>Paste the pairing code generated on the SmartBuildOS property. Clears itself once redeemed.</description>
      </property>
      <property>
        <name>Pairing Backup</name>
        <type>STRING</type>
        <default/>
        <password>true</password>
        <readonly>true</readonly>
        <description>Written by the driver so pairing survives driver updates. Not user-editable; cleared by Unpair.</description>
      </property>
      <property>
        <name>Paired Property</name>
        <type>STRING</type>
        <default>Not paired</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Connection Status</name>
        <type>STRING</type>
        <default>Not paired</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Last Successful Sync</name>
        <type>STRING</type>
        <default>Never</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Touchpanel Display</name>
        <type>LABEL</type>
        <default>Touchpanel Display</default>
      </property>
      <property>
        <name>Touchpanel Name</name>
        <type>STRING</type>
        <default>Touchpanel</default>
        <description>Names the panel this URL is for, e.g. "Kitchen T4". Shown in SmartBuildOS so the right one can be revoked later.</description>
      </property>
      <property>
        <name>Touchpanel URL</name>
        <type>STRING</type>
        <default>Not generated</default>
        <readonly>true</readonly>
        <description>Read-only page for a touchpanel: what is playing, temperatures and system health. Run Actions &gt; Generate Touchpanel URL, then paste this into a Web View driver. Each run creates a NEW panel URL and does not affect ones already installed.</description>
      </property>
      <property>
        <name>Monitoring</name>
        <type>LABEL</type>
        <default>Device Monitoring</default>
      </property>
      <property>
        <name>Device Poll Interval</name>
        <type>LIST</type>
        <default>5m</default>
        <items>
          <item>1m</item>
          <item>5m</item>
          <item>15m</item>
          <item>30m</item>
        </items>
        <description>How often Director is polled for device online/offline changes</description>
      </property>
      <property>
        <name>Discover Network Devices</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <description>Listen for devices announcing themselves on the network (SSDP/UPnP) that are not in this Control4 project</description>
      </property>
      <property>
        <name>Network Scan</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>1h</item>
          <item>6h</item>
          <item>12h</item>
          <item>24h</item>
        </items>
        <description>Ping every address on the subnet to find equipment that is not in this Control4 project. Reports an inventory only — nothing found here is monitored until you add it to Non Control4 Devices</description>
      </property>
      <property>
        <name>Last Network Scan</name>
        <type>STRING</type>
        <default>Never</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Non Control4 Devices</name>
        <type>STRING</type>
        <default/>
        <description>Devices with no Control4 driver, reached directly by IP. Comma separated, Label=host or bare host, e.g. Core Switch=192.168.1.2, NAS=192.168.1.10, 192.168.1.50</description>
      </property>
      <property>
        <name>Devices Offline</name>
        <type>STRING</type>
        <default>0</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Last Device Change</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Director Reloads</name>
        <type>STRING</type>
        <default>0</default>
        <readonly>true</readonly>
        <description>How many times Director has come back up under this driver. A driver update is not counted — it restarts the driver without the controller having gone anywhere.</description>
      </property>
      <property>
        <name>Last Reload</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
        <description>When this driver last started, and what caused it</description>
      </property>
      <property>
        <name>Email Alerts</name>
        <type>LABEL</type>
        <default>Email Alerts</default>
      </property>
      <property>
        <name>Alert Email</name>
        <type>STRING</type>
        <default/>
        <description>Where alerts are sent. SmartBuildOS sends the message — a driver has no mail transport worth relying on — so this address is passed along with each alert.</description>
      </property>
      <property>
        <name>Email on Director Reload</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>On</item>
          <item>Off</item>
        </items>
        <description>Email when the controller reboots or Director reloads, including how many times it has happened</description>
      </property>
      <property>
        <name>Email on Device Offline</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>On</item>
          <item>Off</item>
        </items>
        <description>Email when a device in this project goes offline</description>
      </property>
      <property>
        <name>Email on Low Battery</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>On</item>
          <item>Off</item>
        </items>
        <description>Email when a battery-powered device reports a low battery</description>
      </property>
      <property>
        <name>Email on Sync Failure</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>On</item>
          <item>Off</item>
        </items>
        <description>Email when this driver cannot deliver to SmartBuildOS</description>
      </property>
      <property>
        <name>Reporting</name>
        <type>LABEL</type>
        <default>Reporting</default>
      </property>
      <property>
        <name>Heartbeat Interval</name>
        <type>LIST</type>
        <default>1m</default>
        <items>
          <item>30s</item>
          <item>1m</item>
          <item>2m</item>
          <item>5m</item>
          <item>15m</item>
          <item>30m</item>
          <item>1h</item>
          <item>6h</item>
        </items>
        <description>How often this controller reports in. Remote commands from SmartBuildOS are picked up at each check-in, so this is also the command latency.</description>
      </property>
      <property>
        <name>Full Sync Interval</name>
        <type>LIST</type>
        <default>24h</default>
        <items>
          <item>6h</item>
          <item>12h</item>
          <item>24h</item>
        </items>
        <description>How often the complete device snapshot is re-sent for reconciliation</description>
      </property>
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <default>3 - Info</default>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
    </properties>
  </config>
  <capabilities/>
  <proxies/>
  <connections/>
</devicedata>
