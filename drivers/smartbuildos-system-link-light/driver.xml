<devicedata>
  <name>SmartBuildOS System Link Light</name>
  <version></version>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>System Link Light</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>10/18/2026 12:00 PM</created>
  <modified></modified>
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <category>Light</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>REMOTE_CURRENT</name>
      <type>BOOL</type>
      <condition_statement>Remote Value Is Current</condition_statement>
      <description>NAME is STRING</description>
      <true_text>current</true_text>
      <false_text>not current</false_text>
    </conditional>
  </conditionals>
  <events>
    <event><id>1</id><name>Remote Value Current</name><description>The export's values became current.</description></event>
    <event><id>2</id><name>Remote Value Stale</name><description>The export's values are stale, unknown or unavailable.</description></event>
    <event><id>3</id><name>Control Refused</name><description>The owner refused a control request (see Last Result).</description></event>
    <event><id>4</id><name>Remote Light On</name><description>The remote light reported on.</description></event>
    <event><id>5</id><name>Remote Light Off</name><description>The remote light reported off.</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"></script>
    <documentation file="www/documentation/index.html"></documentation>
    <actions>
      <action><name>Refresh From Bridge</name><command>REFRESH_FROM_BRIDGE</command></action>
      <action><name>Print Diagnostics To Log</name><command>PRINT_DIAGNOSTICS</command></action>
      <action><name>Test: Remote On</name><command>TEST_ON</command></action>
      <action><name>Test: Remote Off</name><command>TEST_OFF</command></action>
      <action><name>Test: Remote 50%</name><command>TEST_HALF</command></action>
    </actions>
    <properties>
      <property><name>Linked Export</name><type>DYNAMIC_LIST</type><default>-</default><description>Which export of the linked project this instance presents. The list is filled by the System Link bridge.</description></property>
      <property><name>Bridge Link</name><type>STRING</type><default>Not asked yet</default><readonly>true</readonly></property>
      <property><name>Remote System State</name><type>STRING</type><default>Offline</default><readonly>true</readonly></property>
      <property><name>Freshness</name><type>STRING</type><default>unknown</default><readonly>true</readonly></property>
      <property><name>Control</name><type>STRING</type><default>view only</default><readonly>true</readonly></property>
      <property><name>Control Window</name><type>STRING</type><default>none</default><readonly>true</readonly><description>The owner's control schedule for this export, and whether it is open now (the owner's own clock decides). Commands are refused here while it is closed.</description></property>
      <property><name>Confirmed State</name><type>STRING</type><default>unknown</default><readonly>true</readonly></property>
      <property><name>Requested State</name><type>STRING</type><default>none</default><readonly>true</readonly></property>
      <property><name>Last Result</name><type>STRING</type><default>none</default><readonly>true</readonly></property>
      <property><name>Driver Status</name><type>STRING</type><default>Starting</default><readonly>true</readonly></property>
      <property><name>Driver Version</name><type>STRING</type><default></default><readonly>true</readonly></property>
      <property><name>Log Level</name><type>LIST</type><items><item>0 - Fatal</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Debug</item><item>5 - Trace</item></items><default>2 - Warning</default></property>
      <property><name>Log Mode</name><type>LIST</type><items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items><default>Off</default></property>
    </properties>
  </config>
  <proxies>
    <proxy proxybindingid="5001" name="System Link Light" image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png">light_v2</proxy>
  </proxies>
  <capabilities>
    <!-- The set the first-party light_v2 drivers declare (Philips Hue, Lutron
         LEAP) and our hardware-tested LuminaLogic light: without on_off and
         ramp_level Navigator showed the companion without a slider. -->
    <dimmer>True</dimmer>
    <on_off>True</on_off>
    <set_level>True</set_level>
    <ramp_level>True</ramp_level>
    <level_target>True</level_target>
    <supports_target>True</supports_target>
    <min_max>False</min_max>
    <click_rates>False</click_rates>
    <hold_rates>False</hold_rates>
    <cold_start>False</cold_start>
    <has_leds>False</has_leds>
    <has_button_events>False</has_button_events>
    <supports_color>False</supports_color>
    <supports_default_on>False</supports_default_on>
    <load_group_support>True</load_group_support>
    <advanced_scene_support>False</advanced_scene_support>
    <buttons_are_virtual>True</buttons_are_virtual>
    <hide_proxy_events>False</hide_proxy_events>
    <hide_proxy_properties>False</hide_proxy_properties>
  </capabilities>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Light</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes><class><classname>LIGHT_V2</classname></class></classes>
    </connection>
  </connections>
</devicedata>
