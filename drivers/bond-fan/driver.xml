<devicedata>
  <name>Bond Fan (SBOS)</name>
  <version/>
  <manufacturer>Olibra</manufacturer>
  <model>Bond Fan (SBOS)</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>08/30/2026 12:00:00 PM</created>
  <modified/>
  <minimum_os_version>3.2.0</minimum_os_version>
  <composer_categories>
    <category>Motorization</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>BOND_FAN_ON</name>
      <type>BOOL</type>
      <condition_statement>Fan power state</condition_statement>
      <description>NAME is STRING</description>
      <true_text>On</true_text>
      <false_text>Off</false_text>
    </conditional>
  </conditionals>
  <events>
    <event><id>1</id><name>Fan On</name><description>The fan turned on.</description></event>
    <event><id>2</id><name>Fan Off</name><description>The fan turned off.</description></event>
    <event><id>3</id><name>Speed Changed</name><description>The fan speed changed.</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <actions>
      <action><name>Print Diagnostics To Log</name><command>PRINT_DIAGNOSTICS</command></action>
      <action><name>Refresh From Gateway</name><command>REFRESH_FROM_GATEWAY</command></action>
      <action><name>Forget Device</name><command>FORGET_DEVICE</command></action>
    </actions>
    <properties>
      <property>
        <name>Bond Device</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not bound</default>
        <description>Which Bond device this instance represents - bind the Bond Fan connection to the Bond Bridge Gateway.</description>
      </property>
      <property>
        <name>Gateway Link</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not bound - bind the Bond Fan connection to the Gateway</default>
      </property>
      <property>
        <name>Fan</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Speed</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Direction</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Last Control</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Status</name>
        <type>LABEL</type>
        <default>Status</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Starting</default>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
      </property>
      <property>
        <name>Logging</name>
        <type>LABEL</type>
        <default>Logging</default>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
        <default>Off</default>
      </property>
    </properties>
    <commands>
      <command>
        <name>Set Direction</name>
        <description>Set fan direction to DIRECTION (forward/reverse)</description>
        <params>
          <param><name>Direction</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Toggle Direction</name>
        <description>Reverse the fan direction</description>
      </command>
      <command>
        <name>Breeze On</name>
        <description>Enable the fan's natural breeze mode</description>
      </command>
      <command>
        <name>Breeze Off</name>
        <description>Disable breeze mode (fan stays at current speed)</description>
      </command>
      <command>
        <name>Set Timer</name>
        <description>Turn the fan off after SECONDS seconds (0 cancels)</description>
        <params>
          <param><name>Seconds</name><type>STRING</type></param>
        </params>
      </command>
    </commands>
  </config>
  <proxies>
    <proxy proxybindingid="5001" name="Bond Fan" image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png">fan</proxy>
  </proxies>
  <capabilities>
    <discrete_levels>6</discrete_levels>
    <speed_names>1,2,3,4,5,6</speed_names>
    <can_set_preset>false</can_set_preset>
    <can_reverse>false</can_reverse>
  </capabilities>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Fan</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes><class><classname>FAN</classname></class></classes>
    </connection>
    <connection>
      <id>300</id>
      <facing>6</facing>
      <connectionname>Toggle Button Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes><class><classname>BUTTON_LINK</classname></class></classes>
    </connection>
    <connection>
      <id>301</id>
      <facing>6</facing>
      <connectionname>Fan Speed Down Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes><class><classname>BUTTON_LINK</classname></class></classes>
    </connection>
    <connection>
      <id>302</id>
      <facing>6</facing>
      <connectionname>Fan Speed Up Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes><class><classname>BUTTON_LINK</classname></class></classes>
    </connection>
    <connection>
      <id>1</id>
      <facing>6</facing>
      <connectionname>Bond Fan</connectionname>
      <type>1</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>SBOS_BOND_FAN</classname>
        </class>
      </classes>
    </connection>
  </connections>
</devicedata>
