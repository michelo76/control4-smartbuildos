  <events>
    <event>
      <id>1</id>
      <name>Connected</name>
      <description>When NAME connects to SmartBuildOS</description>
    </event>
    <event>
      <id>2</id>
      <name>Disconnected</name>
      <description>When NAME loses its connection to SmartBuildOS</description>
    </event>
    <event>
      <id>3</id>
      <name>Sync Failed</name>
      <description>When NAME fails to deliver a payload to SmartBuildOS</description>
    </event>
    <event>
      <id>4</id>
      <name>Paired</name>
      <description>When NAME is successfully paired to a SmartBuildOS property</description>
    </event>
    <event>
      <id>5</id>
      <name>Device Went Offline</name>
      <description>When a device in this project goes offline</description>
    </event>
    <event>
      <id>6</id>
      <name>Device Came Online</name>
      <description>When a device in this project comes back online</description>
    </event>
    <event>
      <id>8</id>
      <name>Service Update</name>
      <description>When SmartBuildOS sends a routine service notice for this home (wire to a push notification)</description>
    </event>
    <event>
      <id>9</id>
      <name>Issue Detected</name>
      <description>When SmartBuildOS reports a problem needing attention at this home (wire to a push notification)</description>
    </event>
    <event>
      <id>11</id>
      <name>Issue Updated</name>
      <description>When SmartBuildOS updates a previously reported problem at this home (wire to a push notification)</description>
    </event>
    <event>
      <id>10</id>
      <name>Issue Resolved</name>
      <description>When SmartBuildOS reports a previously detected problem is resolved (wire to a push notification)</description>
    </event>
    <event>
      <id>7</id>
      <name>Director Reloaded</name>
      <description>When Director comes back up under this driver — a controller reboot, a Director restart or a project reload. Deliberately NOT fired by a driver update, which restarts the driver without the controller having gone anywhere.</description>
    </event>
    <event><id>12</id><name>System Startup Observed</name><description>When the Agent classifies a Control4 system startup</description></event>
    <event><id>13</id><name>Controller Reboot Observed</name><description>When the Agent observes a changed controller boot identity</description></event>
    <event><id>14</id><name>Startup Threshold Reached</name><description>When the configured startup count threshold is reached</description></event>
    <event><id>15</id><name>Report Ready</name><description>When SmartBuildOS confirms a requested System Studio report is ready</description></event>
    <event><id>16</id><name>Report Failed</name><description>When SmartBuildOS reports that a requested system report failed</description></event>
    <event><id>17</id><name>Notification Failed</name><description>When SmartBuildOS cannot accept an approved-recipient notification</description></event>
    <event><id>18</id><name>Cloud Connection Changed</name><description>When the Agent cloud connection state changes</description></event>
    <event><id>19</id><name>License Status Changed</name><description>When the Agent license state changes</description></event>
    <event><id>20</id><name>Controller Mismatch</name><description>When execution-controller evidence conflicts with the verified primary controller</description></event>
    <event><id>21</id><name>Project Changed</name><description>Composer added, removed, renamed or rebound something in the project (debounced 30 s)</description></event>
    <event><id>22</id><name>Clock Drift Detected</name><description>The controller clock is more than two minutes from SmartBuildOS</description></event>
    <event><id>23</id><name>OS Update Started</name><description>Director reported that an OS update began</description></event>
    <event><id>24</id><name>Programming Changed</name><description>Composer programming was added, removed or moved</description></event>
    <event><id>25</id><name>Unexpected Restart</name><description>Director came back with no shutdown or OS update before it (power loss, crash, hard reset)</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <actions>
