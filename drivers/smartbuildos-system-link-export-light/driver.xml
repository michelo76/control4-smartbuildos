<devicedata>
  <name>SmartBuildOS System Link Export Light</name>
  <version></version>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>System Link Export Light</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>10/21/2026 12:00 AM</created>
  <modified></modified>
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <category>Others</category>
  </composer_categories>
  <config>
    <script file="driver.lua" jit="1"></script>
    <documentation file="www/documentation/index.html"></documentation>
    <actions>
      <action><name>Register Export</name><command>REGISTER_EXPORT</command></action>
      <action><name>Remove Export</name><command>REMOVE_EXPORT</command></action>
    </actions>
    <properties>
      <property><name>Export Status</name><type>STRING</type><default>Bind the light in Composer Connections</default><readonly>true</readonly></property>
      <property><name>Export Name</name><type>STRING</type><default></default><description>Letters, digits and underscores; starts with a letter. Prefilled from the bound light's name when empty. Becomes &lt;Alias&gt;.&lt;Name&gt;_On and _Level on the linked project.</description></property>
      <property><name>Export Control</name><type>LIST</type><items><item>View only</item><item>Control allowed</item></items><default>View only</default></property>
      <property><name>Export Operations</name><type>STRING</type><default></default><description>Optional, comma-separated: on,off,set_level. Blank allows all three.</description></property>
      <property><name>Driver Status</name><type>STRING</type><default>Starting</default><readonly>true</readonly></property>
      <property><name>Driver Version</name><type>STRING</type><default></default><readonly>true</readonly></property>
      <property><name>Log Level</name><type>LIST</type><items><item>0 - Fatal</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Debug</item><item>5 - Trace</item></items><default>2 - Warning</default></property>
      <property><name>Log Mode</name><type>LIST</type><items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items><default>Off</default></property>
    </properties>
  </config>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Light</connectionname>
      <type>1</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes><class><classname>LIGHT_V2</classname></class></classes>
    </connection>
  </connections>
</devicedata>
