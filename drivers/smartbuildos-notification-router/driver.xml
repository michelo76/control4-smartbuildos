<devicedata>
  <name>SmartBuildOS Notification Router</name>
  <version></version>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>Notification Router</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>11/09/2026 12:00 PM</created>
  <modified></modified>
  <combo>true</combo>
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>ROUTER_READY</name>
      <type>BOOL</type>
      <condition_statement>At least one target is configured and enabled</condition_statement>
      <description>NAME STRING</description>
      <true_text>has a target ready</true_text>
      <false_text>has no target ready</false_text>
    </conditional>
    <conditional>
      <id>2</id>
      <name>QUIET_HOURS_ACTIVE</name>
      <type>BOOL</type>
      <condition_statement>Quiet hours are active on every enabled target</condition_statement>
      <description>NAME STRING</description>
      <true_text>is in quiet hours</true_text>
      <false_text>is not in quiet hours</false_text>
    </conditional>
  </conditionals>
  <variables>
    <variable><id>3000</id><name>ROUTER_STATUS</name><type>STRING</type><default>starting</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3001</id><name>LAST_NOTIFICATION</name><type>STRING</type><default></default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3002</id><name>SENT_TODAY</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3003</id><name>FAILED_TODAY</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3004</id><name>LAST_FAILED_TARGET</name><type>STRING</type><default></default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3005</id><name>PENDING_DELIVERIES</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
  </variables>
  <events>
    <event><id>1</id><name>Notification Sent</name><description>A notification was accepted by a target</description></event>
    <event><id>2</id><name>Delivery Failed</name><description>A notification was not accepted by a target after every retry (see Last Failed Target)</description></event>
    <event><id>3</id><name>Target Unreachable</name><description>A target failed on the first attempt; retries are under way</description></event>
    <event><id>4</id><name>Quiet Hours Suppressed</name><description>A notification was held back by a target's quiet hours (critical never is)</description></event>
    <event><id>5</id><name>Rate Limited</name><description>A target reached its hourly limit and a notification was dropped</description></event>
    <event><id>6</id><name>Router Degraded</name><description>Sending stopped: licence enforcement or no target configured</description></event>
    <event><id>7</id><name>Router Restored</name><description>Sending is possible again</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"></script>
    <documentation file="www/documentation/index.html"></documentation>
    <actions>
      <action><name>Send Test To Telegram</name><command>TEST_TELEGRAM</command></action>
      <action><name>Send Test To Pushover</name><command>TEST_PUSHOVER</command></action>
      <action><name>Send Test To Webhook</name><command>TEST_WEBHOOK</command></action>
      <action><name>Send Test To Generic Webhook</name><command>TEST_GENERIC</command></action>
      <action><name>Send Test To Twilio SMS</name><command>TEST_TWILIO</command></action>
      <action><name>Print Delivery Log</name><command>PRINT_LOG</command></action>
      <action><name>Print Router Status</name><command>PRINT_STATUS</command></action>
      <action><name>Register With Agent Now</name><command>REGISTER_NOW</command></action>
      <action><name>Refresh Status</name><command>REFRESH_STATUS</command></action>
      <action><name>Clear Delivery Log</name><command>CLEAR_LOG</command></action>
    </actions>
    <commands>
      <command>
        <name>NOTIFY</name>
        <description>Send a notification to one target (or all) with a priority</description>
        <params>
          <param><name>CHANNEL</name><type>LIST</type><items><item>All</item><item>Telegram</item><item>Pushover</item><item>Webhook</item><item>Generic Webhook</item><item>Twilio SMS</item></items></param>
          <param><name>PRIORITY</name><type>LIST</type><items><item>low</item><item>normal</item><item>high</item><item>critical</item></items></param>
          <param><name>TITLE</name><type>STRING</type></param>
          <param><name>MESSAGE</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>NOTIFY_ALL</name>
        <description>Send a notification to every enabled target</description>
        <params>
          <param><name>PRIORITY</name><type>LIST</type><items><item>low</item><item>normal</item><item>high</item><item>critical</item></items></param>
          <param><name>TITLE</name><type>STRING</type></param>
          <param><name>MESSAGE</name><type>STRING</type></param>
        </params>
      </command>
    </commands>
    <properties>
      <property><name>Driver Status</name><type>STRING</type><default>Starting</default><readonly>true</readonly></property>
      <property><name>Driver Version</name><type>STRING</type><default></default><readonly>true</readonly></property>
      <property><name>Router Status</name><type>STRING</type><default>starting</default><readonly>true</readonly></property>
      <property><name>License Status</name><type>STRING</type><default>No SmartBuildOS Agent Found</default><readonly>true</readonly></property>
      <property><name>License Source</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Subscription Tier</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>SmartBuildOS Company</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Targets Ready</name><type>STRING</type><default>none</default><readonly>true</readonly></property>
      <property><name>Last Notification</name><type>STRING</type><default>none yet</default><readonly>true</readonly></property>
      <property><name>Sent Today</name><type>STRING</type><default>0</default><readonly>true</readonly></property>
      <property><name>Failed Today</name><type>STRING</type><default>0</default><readonly>true</readonly></property>
      <property><name>Last Router Error</name><type>STRING</type><default>none</default><readonly>true</readonly></property>
      <property><name>Dedupe Window</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>3600</maximum><default>300</default></property>
      <property><name>Rate Limit Per Hour</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>600</maximum><default>60</default></property>
      <property><name>Telegram</name><type>LIST</type><items><item>Off</item><item>On</item></items><default>Off</default><description>Telegram bot messages. Create a bot with BotFather, add it to a chat or group, and read the chat id from getUpdates.</description></property>
      <property><name>Telegram Bot Token</name><type>STRING</type><password>true</password><default></default></property>
      <property><name>Telegram Chat ID</name><type>STRING</type><default></default></property>
      <property><name>Telegram Minimum Priority</name><type>LIST</type><items><item>low</item><item>normal</item><item>high</item><item>critical</item></items><default>low</default></property>
      <property><name>Telegram Quiet Start</name><type>STRING</type><default></default></property>
      <property><name>Telegram Quiet End</name><type>STRING</type><default></default></property>
      <property><name>Pushover</name><type>LIST</type><items><item>Off</item><item>On</item></items><default>Off</default><description>Pushover push notifications. Critical priority is sent as a Pushover emergency that repeats until acknowledged.</description></property>
      <property><name>Pushover App Token</name><type>STRING</type><password>true</password><default></default></property>
      <property><name>Pushover User Key</name><type>STRING</type><password>true</password><default></default></property>
      <property><name>Pushover Minimum Priority</name><type>LIST</type><items><item>low</item><item>normal</item><item>high</item><item>critical</item></items><default>low</default></property>
      <property><name>Pushover Quiet Start</name><type>STRING</type><default></default></property>
      <property><name>Pushover Quiet End</name><type>STRING</type><default></default></property>
      <property><name>Webhook</name><type>LIST</type><items><item>Off</item><item>On</item></items><default>Off</default><description>Slack or Discord incoming webhook. Paste the webhook URL; both services accept the message shape sent.</description></property>
      <property><name>Webhook URL</name><type>STRING</type><password>true</password><default></default></property>
      <property><name>Webhook Minimum Priority</name><type>LIST</type><items><item>low</item><item>normal</item><item>high</item><item>critical</item></items><default>low</default></property>
      <property><name>Webhook Quiet Start</name><type>STRING</type><default></default></property>
      <property><name>Webhook Quiet End</name><type>STRING</type><default></default></property>
      <property><name>Generic Webhook</name><type>LIST</type><items><item>Off</item><item>On</item></items><default>Off</default><description>POSTs a JSON document (title, message, priority, channel, source, sent_at) to any URL, with an optional bearer token.</description></property>
      <property><name>Generic Webhook URL</name><type>STRING</type><default></default></property>
      <property><name>Generic Webhook Bearer Token</name><type>STRING</type><password>true</password><default></default></property>
      <property><name>Generic Webhook Minimum Priority</name><type>LIST</type><items><item>low</item><item>normal</item><item>high</item><item>critical</item></items><default>low</default></property>
      <property><name>Generic Webhook Quiet Start</name><type>STRING</type><default></default></property>
      <property><name>Generic Webhook Quiet End</name><type>STRING</type><default></default></property>
      <property><name>Twilio SMS</name><type>LIST</type><items><item>Off</item><item>On</item></items><default>Off</default><description>Text messages through Twilio. Numbers in E.164 form (+15551234567).</description></property>
      <property><name>Twilio Account SID</name><type>STRING</type><default></default></property>
      <property><name>Twilio Auth Token</name><type>STRING</type><password>true</password><default></default></property>
      <property><name>Twilio From Number</name><type>STRING</type><default></default></property>
      <property><name>Twilio To Number</name><type>STRING</type><default></default></property>
      <property><name>Twilio Minimum Priority</name><type>LIST</type><items><item>low</item><item>normal</item><item>high</item><item>critical</item></items><default>high</default></property>
      <property><name>Twilio Quiet Start</name><type>STRING</type><default></default></property>
      <property><name>Twilio Quiet End</name><type>STRING</type><default></default></property>
      <property><name>Log Level</name><type>LIST</type><items><item>0 - Fatal</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Debug</item><item>5 - Trace</item></items><default>2 - Warning</default></property>
      <property><name>Log Mode</name><type>LIST</type><items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items><default>Off</default></property>
    </properties>
  </config>
  <proxies>
  </proxies>
  <capabilities>
  </capabilities>
  <connections>
  </connections>
</devicedata>
