<devicedata>
  <!-- Added to the project as a normal driver (combo/self-proxy), one per
       project. A true DriverWorks <agent> did not reliably surface in Composer's
       Agents panel for this third-party driver in the field (2026-08-29), so it
       stays a project driver — added via Add or Update Driver, not the Agents
       panel. It is still the singular SmartBuildOS Agent: the licensing
       authority every SmartBuildOS driver depends on. -->
  <name>SmartBuildOS Agent</name>
  <version/>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>SmartBuildOS Agent</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>08/15/2026 12:00:00 PM</created>
  <modified/>
  <combo>true</combo>
  <minimum_os_version>3.3.1</minimum_os_version>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>SMARTBUILDOS_CONNECTED</name>
      <type>BOOL</type>
      <condition_statement>SmartBuildOS connection status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Connected</true_text>
      <false_text>Disconnected</false_text>
    </conditional>
    <conditional>
      <id>2</id>
      <name>SMARTBUILDOS_PAIRED</name>
      <type>BOOL</type>
      <condition_statement>SmartBuildOS pairing status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Paired</true_text>
      <false_text>Not paired</false_text>
    </conditional>
  </conditionals>
  <variables>
    <variable>
      <id>2000</id>
      <name>DIRECTOR_RELOADS</name>
      <type>NUMBER</type>
      <default>0</default>
