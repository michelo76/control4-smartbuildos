<devicedata>
  <name>Bond Fireplace (SBOS)</name>
  <version/>
  <manufacturer>Olibra</manufacturer>
  <model>Bond Fireplace (SBOS)</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>08/30/2026 12:00:00 PM</created>
  <modified/>
  <minimum_os_version>3.2.0</minimum_os_version>
  <composer_categories>
    <category>Comfort</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>BOND_FIREPLACE_ON</name>
      <type>BOOL</type>
      <condition_statement>Fireplace flame state</condition_statement>
      <description>NAME is STRING</description>
      <true_text>On</true_text>
      <false_text>Off</false_text>
    </conditional>
  </conditionals>
  <events>
    <event><id>1</id><name>Fireplace On</name><description>The fireplace turned on.</description></event>
    <event><id>2</id><name>Fireplace Off</name><description>The fireplace turned off.</description></event>
    <event><id>3</id><name>Flame Changed</name><description>The flame level changed.</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <actions>
      <action><name>Print Diagnostics To Log</name><command>PRINT_DIAGNOSTICS</command></action>
      <action><name>Refresh From Gateway</name><command>REFRESH_FROM_GATEWAY</command></action>
      <action><name>Forget Device</name><command>FORGET_DEVICE</command></action>
    </actions>
    <properties>
      <property>
        <name>Bond Device</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not bound</default>
        <description>Which Bond fireplace this instance represents - bind the Bond Fireplace connection to the Bond Bridge Gateway.</description>
      </property>
      <property>
        <name>Gateway Link</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not bound - bind the Bond Fireplace connection to the Gateway</default>
      </property>
      <property>
        <name>Fireplace</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Flame</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Fireplace Fan</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Last Control</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Status</name>
        <type>LABEL</type>
        <default>Status</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Starting</default>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
      </property>
      <property>
        <name>Logging</name>
        <type>LABEL</type>
        <default>Logging</default>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
        <default>Off</default>
      </property>
    </properties>
    <commands>
      <command>
        <name>Turn On</name>
        <description>Turn the fireplace on</description>
      </command>
      <command>
        <name>Turn Off</name>
        <description>Turn the fireplace off</description>
      </command>
      <command>
        <name>Set Flame</name>
        <description>Set flame level to LEVEL percent (1-100)</description>
        <params>
          <param><name>Level</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Set Fireplace Fan</name>
        <description>Set the fireplace fan SPEED percent (0 = off)</description>
        <params>
          <param><name>Speed</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Set Timer</name>
        <description>Turn the fireplace off after SECONDS seconds (0 cancels)</description>
        <params>
          <param><name>Seconds</name><type>STRING</type></param>
        </params>
      </command>
    </commands>
  </config>
  <proxies>
    <proxy proxybindingid="5001" name="Bond Fireplace" image_source="c4z" large_image="icons/device_lg.png" small_image="icons/device_sm.png">uibutton</proxy>
    <proxy proxybindingid="5002" name="Flame Level" image_source="c4z" large_image="icons/device_lg.png" small_image="icons/device_sm.png">uibutton</proxy>
