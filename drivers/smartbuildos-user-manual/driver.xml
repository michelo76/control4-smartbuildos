<devicedata>
  <name>SmartBuildOS Home Guide</name>
  <version></version>
  <manufacturer>SmartBuildOS</manufacturer>
  <model>Home Guide</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>11/09/2026 12:00 PM</created>
  <modified></modified>
  <minimum_os_version>3.3.2</minimum_os_version>
  <small image_source="c4z">www/icons/device_sm.png</small>
  <large image_source="c4z">www/icons/device_lg.png</large>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <conditionals>
  </conditionals>
  <variables>
    <variable><id>3000</id><name>MANUAL_STATUS</name><type>STRING</type><default>starting</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3001</id><name>MANUAL_ROOMS</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3002</id><name>MANUAL_DEVICES</name><type>NUMBER</type><default>0</default><readonly>true</readonly><hidden>false</hidden></variable>
    <variable><id>3003</id><name>LAST_REBUILT</name><type>STRING</type><default></default><readonly>true</readonly><hidden>false</hidden></variable>
  </variables>
  <events>
    <event><id>1</id><name>Manual Rebuilt</name><description>The Home Guide was rebuilt from the project</description></event>
    <event><id>2</id><name>Guide Unavailable</name><description>The guide stopped serving (licence denial with enforcement, or the relay port is taken)</description></event>
    <event><id>3</id><name>Guide Restored</name><description>The guide is serving again</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"></script>
    <documentation file="www/documentation/index.html"></documentation>
    <actions>
      <action><name>Refresh Manual</name><command>REFRESH_MANUAL</command></action>
      <action><name>Print Manual Outline</name><command>PRINT_OUTLINE</command></action>
      <action><name>Republish App URL</name><command>REPUBLISH_URL</command></action>
      <action><name>Register With Agent Now</name><command>REGISTER_NOW</command></action>
      <action><name>Refresh Status</name><command>REFRESH_STATUS</command></action>
    </actions>
    <commands>
      <command>
        <name>REBUILD_MANUAL</name>
        <description>Rebuild the Home Guide from the project now</description>
        <params></params>
      </command>
    </commands>
    <properties>
      <property><name>Driver Status</name><type>STRING</type><default>Starting</default><readonly>true</readonly></property>
      <property><name>Driver Version</name><type>STRING</type><default></default><readonly>true</readonly></property>
      <property><name>Manual Status</name><type>STRING</type><default>starting</default><readonly>true</readonly></property>
      <property><name>Devices In Manual</name><type>STRING</type><default>not built yet</default><readonly>true</readonly></property>
      <property><name>Last Rebuilt</name><type>STRING</type><default>never</default><readonly>true</readonly></property>
      <property><name>App Data Relay</name><type>STRING</type><default>Starting</default><readonly>true</readonly></property>
      <property><name>License Status</name><type>STRING</type><default>No SmartBuildOS Agent Found</default><readonly>true</readonly></property>
      <property><name>License Source</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Subscription Tier</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>SmartBuildOS Company</name><type>STRING</type><default>-</default><readonly>true</readonly></property>
      <property><name>Home Name</name><type>STRING</type><default></default></property>
      <property><name>Dealer Name</name><type>STRING</type><default></default></property>
      <property><name>Dealer Phone</name><type>STRING</type><default></default></property>
      <property><name>Dealer Email</name><type>STRING</type><default></default></property>
      <property><name>Support Hours</name><type>STRING</type><default></default></property>
      <property><name>Emergency Note</name><type>STRING</type><default></default></property>
      <property><name>Room Note 1</name><type>STRING</type><default></default></property>
      <property><name>Room Note 2</name><type>STRING</type><default></default></property>
      <property><name>Room Note 3</name><type>STRING</type><default></default></property>
      <property><name>Room Note 4</name><type>STRING</type><default></default></property>
      <property><name>Room Note 5</name><type>STRING</type><default></default></property>
      <property><name>Room Note 6</name><type>STRING</type><default></default></property>
      <property><name>App Relay Address</name><type>STRING</type><default>Auto</default></property>
      <property><name>Log Level</name><type>LIST</type><items><item>0 - Fatal</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Debug</item><item>5 - Trace</item></items><default>2 - Warning</default></property>
      <property><name>Log Mode</name><type>LIST</type><items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items><default>Off</default></property>
    </properties>
  </config>
  <capabilities>
    <web_view_url proxybindingid="5001">controller://driver/smartbuildos-user-manual/app/index.html</web_view_url>
    <mobile_web_view_enabled>true</mobile_web_view_enabled>
    <navigator_display_option proxybindingid="5001">
      <display_icons>
        <Icon height="1024" width="1024">controller://driver/smartbuildos-user-manual/icons/device/experience_1024.png</Icon>
        <Icon height="512" width="512">controller://driver/smartbuildos-user-manual/icons/device/experience_512.png</Icon>
        <Icon height="300" width="300">controller://driver/smartbuildos-user-manual/icons/device/experience_300.png</Icon>
        <Icon height="90" width="90">controller://driver/smartbuildos-user-manual/icons/device/experience_90.png</Icon>
        <Icon height="70" width="70">controller://driver/smartbuildos-user-manual/icons/device/experience_70.png</Icon>
      </display_icons>
    </navigator_display_option>
  </capabilities>
  <proxies>
    <proxy proxybindingid="5001" name="Home Guide" primary="True" image_source="c4z"
           large_image="www/icons/device_lg.png" small_image="www/icons/device_sm.png">uibutton</proxy>
  </proxies>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>UIBUTTON</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>UIBUTTON</classname>
        </class>
      </classes>
    </connection>
  </connections>
</devicedata>
