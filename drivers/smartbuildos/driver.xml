      <action>
        <name>Refresh Entitlements Now</name>
        <command>REFRESH_ENTITLEMENTS</command>
      </action>
      <action>
        <name>Print Entitlements</name>
        <command>PRINT_ENTITLEMENTS</command>
      </action>
      <action>
        <name>Test Connection</name>
        <command>TEST_CONNECTION</command>
      </action>
      <action>
        <name>Poll Devices Now</name>
        <command>POLL_DEVICES</command>
      </action>
      <action>
        <name>Send Full Sync</name>
        <command>SEND_FULL_SYNC</command>
      </action>
      <action>
        <name>Send Heartbeat Now</name>
        <command>SEND_HEARTBEAT</command>
      </action>
      <action>
        <name>Scan Network Now</name>
        <command>SCAN_NETWORK</command>
      </action>
      <action>
        <name>Report Telemetry Survey</name>
        <command>REPORT_TELEMETRY_SURVEY</command>
      </action>
      <action>
        <name>Report Diagnostics</name>
        <command>REPORT_DIAGNOSTICS</command>
      </action>
      <action>
        <name>Probe Capabilities</name>
        <command>PROBE_CAPABILITIES</command>
      </action>
      <action>
        <name>Generate Touchpanel URL</name>
        <command>GENERATE_DISPLAY_URL</command>
      </action>
      <action><name>Generate System Report</name><command>GENERATE_SYSTEM_REPORT</command></action>
      <action><name>Send System Report</name><command>SEND_SYSTEM_REPORT</command></action>
      <action><name>Send Test Notification</name><command>SEND_TEST_NOTIFICATION</command></action>
      <action><name>Refresh Inventory</name><command>REFRESH_INVENTORY</command></action>
      <action><name>Check for Updates</name><command>CHECK_FOR_UPDATES</command></action>
      <action><name>Enter Service Mode</name><command>ENTER_SERVICE_MODE</command></action>
      <action><name>Exit Service Mode</name><command>EXIT_SERVICE_MODE</command></action>
      <action><name>Refresh Status</name><command>REFRESH_STATUS</command></action>
      <action><name>Camera Read-Only Probe</name><command>CAMERA_READ_ONLY_PROBE</command></action>
      <action>
        <name>Unpair</name>
        <command>UNPAIR</command>
      </action>
      <!-- #ifndef DRIVERCENTRAL -->
      <action>
        <name>Update Drivers</name>
        <command>UPDATE_DRIVERS</command>
      </action>
      <!-- #endif -->
    </actions>
    <commands>
      <command>
        <name>SEND_EVENT</name>
        <description>Send a named event to SmartBuildOS</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>DETAIL</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_STATE</name>
        <description>Report a named state to SmartBuildOS telemetry (e.g. Rack Door = OPEN)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>VALUE</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_MEASUREMENT</name>
        <description>Report a numeric measurement to SmartBuildOS telemetry (e.g. UPS Battery = 37 %)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>VALUE</name>
            <type>STRING</type>
          </param>
          <param>
            <name>UNIT</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_COUNTER</name>
        <description>Increment a named counter in SmartBuildOS telemetry (e.g. Garage Door Cycles)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_FAULT</name>
        <description>Report a fault to SmartBuildOS telemetry (e.g. Generator: Low battery)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>DETAIL</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>REPORT_SERVICE_EVENT</name>
        <description>Report a service-relevant event to SmartBuildOS telemetry (e.g. Filter replaced)</description>
        <params>
          <param>
            <name>NAME</name>
            <type>STRING</type>
          </param>
          <param>
            <name>DETAIL</name>
            <type>STRING</type>
          </param>
        </params>
      </command>
      <command>
        <name>RECORD_SERVICE_NOTE</name>
        <description>Record an integrator-authored service note in SmartBuildOS</description>
        <params>
          <param><name>NOTE</name><type>STRING</type></param>
        </params>
      </command>
    </commands>
    <properties>
      <property>
        <name>Cloud</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <property>
        <name>Update Channel</name>
        <type>LIST</type>
        <default>Production</default>
        <items>
          <item>Production</item>
          <item>Prerelease</item>
        </items>
      </property>
      <property>
        <name>Update Source</name>
        <type>LIST</type>
        <default>Auto</default>
        <items>
          <item>Auto</item>
          <item>SmartBuildOS</item>
          <item>GitHub</item>
        </items>
        <description>Where driver updates come from. Auto: from SmartBuildOS when paired, falling back to GitHub. SmartBuildOS: the platform only. GitHub: public releases only.</description>
      </property>
      <property>
        <name>SmartBuildOS Settings</name>
        <type>LABEL</type>
        <default>SmartBuildOS Connection</default>
      </property>
      <property>
        <name>API URL</name>
        <type>STRING</type>
        <default>https://app.smartbuildos.io</default>
        <readonly>true</readonly>
        <description>SmartBuildOS endpoint this driver reports to. Fixed: a mistyped URL silently breaks pairing and every upload.</description>
      </property>
      <property>
        <name>Pairing Code</name>
        <type>STRING</type>
        <default/>
        <password>true</password>
        <description>Paste the pairing code generated on the SmartBuildOS property. Clears itself once redeemed.</description>
      </property>
      <property>
        <name>Account Number</name>
        <type>STRING</type>
        <default/>
        <description>Alternative to a pairing code: enter your SmartBuildOS account number and a verification code will be emailed to the account's address. Then enter it in Verification Code.</description>
      </property>
      <property>
        <name>Verification Code</name>
        <type>STRING</type>
        <default/>
        <password>true</password>
        <description>Enter the code emailed to your account to finish pairing by account number. Single-use; clears itself once redeemed.</description>
      </property>
      <property>
        <name>Pairing Backup</name>
        <type>STRING</type>
        <default/>
        <password>true</password>
        <readonly>true</readonly>
        <description>Written by the driver so pairing survives driver updates. Not user-editable; cleared by Unpair.</description>
      </property>
      <property>
        <name>Remote Control</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>Identify only</item>
          <item>Comfort</item>
          <item>Full control</item>
        </items>
        <default>Identify only</default>
        <description>What SmartBuildOS may COMMAND in this home (D-8), each tier a superset of the ones above it. This gate lives HERE, on the controller, so no platform compromise can command a home above the tier its dealer chose. Off: refuses every write. Identify only: flash a keypad's LEDs to locate a device — nothing that changes how the home behaves. Comfort: lights, scenes, thermostat setpoints (clamped 60–85°F, never off), and live camera snapshots. Full control: locks, garage, and security — and even then SmartBuildOS requires the HOMEOWNER to approve each one on their phone before it runs.</description>
      </property>
      <property>
        <name>Paired Property</name>
        <type>STRING</type>
        <default>Not paired</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Connection Status</name>
        <type>STRING</type>
        <default>Not paired</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>License Cloud</name>
        <type>STRING</type>
        <default>Not paired - drivers run in legacy mode</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Support ID</name>
        <type>STRING</type>
        <default></default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>SmartBuildOS Company</name>
        <type>STRING</type>
        <default>Not registered - pair to a company</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Subscription Tier</name>
        <type>STRING</type>
        <default>Not paired</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Licensed Drivers</name>
        <type>STRING</type>
        <default>No SmartBuildOS drivers installed</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Last Successful Sync</name>
        <type>STRING</type>
        <default>Never</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Touchpanel Display</name>
        <type>LABEL</type>
        <default>Touchpanel Display</default>
      </property>
      <property>
        <name>Touchpanel Name</name>
        <type>STRING</type>
        <default>Touchpanel</default>
        <description>Names the panel this URL is for, e.g. "Kitchen T4". Shown in SmartBuildOS so the right one can be revoked later.</description>
      </property>
      <property>
        <name>Touchpanel URL</name>
        <type>STRING</type>
        <default>Not generated</default>
        <readonly>true</readonly>
        <description>Read-only page for a touchpanel: what is playing, temperatures and system health. Run Actions &gt; Generate Touchpanel URL, then paste this into a Web View driver. Each run creates a NEW panel URL and does not affect ones already installed.</description>
      </property>
      <property>
        <name>Monitoring</name>
        <type>LABEL</type>
        <default>Device Monitoring</default>
      </property>
      <property>
        <name>Device Poll Interval</name>
        <type>LIST</type>
        <default>5m</default>
        <items>
          <item>1m</item>
          <item>5m</item>
          <item>15m</item>
          <item>30m</item>
        </items>
        <description>How often Director is polled for device online/offline changes</description>
      </property>
      <property>
        <name>Discover Network Devices</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <description>Listen for devices announcing themselves on the network (SSDP/UPnP) that are not in this Control4 project</description>
      </property>
      <property>
        <name>Network Scan</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>1h</item>
          <item>6h</item>
          <item>12h</item>
          <item>24h</item>
        </items>
        <description>Ping every address on the subnet to find equipment that is not in this Control4 project. Reports an inventory only — nothing found here is monitored until you add it to Non Control4 Devices</description>
      </property>
      <property>
        <name>Last Network Scan</name>
        <type>STRING</type>
        <default>Never</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Non Control4 Devices</name>
        <type>STRING</type>
        <default/>
        <description>Devices with no Control4 driver, reached directly by IP. Comma separated, Label=host or bare host, e.g. Core Switch=192.168.1.2, NAS=192.168.1.10, 192.168.1.50</description>
      </property>
      <property>
        <name>Devices Offline</name>
        <type>STRING</type>
        <default>0</default>
