<devicedata>
  <name>UniFi Protect Gateway (SBOS)</name>
  <version/>
  <manufacturer>Ubiquiti</manufacturer>
  <model>UniFi Protect Gateway (SBOS)</model>
  <creator>SmartBuildOS</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 SmartBuildOS. All rights reserved.</copyright>
  <created>08/28/2026 12:00:00 PM</created>
  <modified/>
  <combo>true</combo>
  <!-- 3.3.2, not 3.3.1: the parent alone would run on less, but the child
       camera driver needs the dynamic-streams API (OS 3.3.2) and a parent
       that installs where its children refuse to is a support case. -->
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <category>Cameras</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>UNIFI_PROTECT_CONNECTED</name>
      <type>BOOL</type>
      <condition_statement>UniFi Protect connection status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Connected</true_text>
      <false_text>Disconnected</false_text>
    </conditional>
  </conditionals>
  <!-- Registered again at init (registerGatewayEvents) because XML events
       only register when an instance is first added. Ids are frozen. -->
  <events>
    <event><id>1</id><name>Armed</name><description>Protect armed (any profile).</description></event>
    <event><id>2</id><name>Disarmed</name><description>Protect disarmed.</description></event>
    <event><id>3</id><name>Arm Profile Changed</name><description>The active Protect arm profile changed.</description></event>
    <event><id>4</id><name>Breach Detected</name><description>Protect detected an alarm breach.</description></event>
    <event><id>5</id><name>Siren Started</name><description>A Protect siren started sounding.</description></event>
    <event><id>6</id><name>Siren Stopped</name><description>A Protect siren stopped.</description></event>
    <event><id>7</id><name>NVR Offline</name><description>The Protect console stopped answering.</description></event>
    <event><id>8</id><name>NVR Online</name><description>The Protect console is answering again.</description></event>
    <event><id>9</id><name>Device Offline</name><description>A Protect device went offline.</description></event>
    <event><id>10</id><name>Device Online</name><description>A Protect device came back online.</description></event>
    <event><id>11</id><name>Custom Webhook Received</name><description>A webhook arrived from Protect's Alarm Manager. LAST_WEBHOOK_NAME identifies it.</description></event>
    <event><id>12</id><name>Entry Opened</name><description>An alarm hub entry opened.</description></event>
    <event><id>13</id><name>Entry Closed</name><description>An alarm hub entry closed.</description></event>
    <event><id>14</id><name>Glass Break Detected</name><description>An alarm hub detected glass breaking.</description></event>
    <event><id>15</id><name>Smoke Alarm Detected</name><description>An alarm hub detected a smoke alarm.</description></event>
    <event><id>16</id><name>Hub Motion Detected</name><description>An alarm hub detected motion.</description></event>
    <event><id>17</id><name>Hub Tamper Detected</name><description>An alarm hub or its device was tampered with.</description></event>
    <event><id>18</id><name>Hub Button Pressed</name><description>An alarm hub button was pressed.</description></event>
    <event><id>19</id><name>Hub Battery Low</name><description>An alarm hub battery is low.</description></event>
    <event><id>20</id><name>Hub Relay Switched</name><description>An alarm hub relay switched.</description></event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <actions>
      <action>
        <name>Test Connection</name>
        <command>TEST_CONNECTION</command>
      </action>
      <action>
        <name>Sync Devices Now</name>
        <command>SYNC_DEVICES</command>
      </action>
      <action>
        <name>Print Inventory To Log</name>
        <command>PRINT_INVENTORY</command>
      </action>
      <action>
        <name>Print Camera Bindings To Log</name>
        <command>PRINT_CAMERA_BINDINGS</command>
      </action>
      <action>
        <name>Prune Missing Camera Bindings</name>
        <command>PRUNE_STALE_CAMERAS</command>
      </action>
      <action>
        <name>Auto Provision Protect Devices</name>
        <command>AUTO_PROVISION_DEVICES</command>
      </action>
      <action>
        <name>Print Arm Profiles To Log</name>
        <command>PRINT_ARM_PROFILES</command>
      </action>
      <action>
        <name>Print Security Devices To Log</name>
        <command>PRINT_SECURITY_DEVICES</command>
      </action>
      <action>
        <name>Refresh License</name>
        <command>REFRESH_LICENSE</command>
      </action>
      <action>
        <name>Forget API Key</name>
        <command>FORGET_API_KEY</command>
      </action>
    </actions>
    <properties>
      <property>
        <name>UniFi Protect</name>
        <type>LABEL</type>
        <default>UniFi Protect Console</default>
      </property>
      <property>
        <name>Console Address</name>
        <type>STRING</type>
        <default>https://192.168.1.1</default>
        <description>Address of the UniFi console running Protect. A bare IP or hostname is fine; anything pasted after the host is ignored. The console must be reachable from this controller.</description>
      </property>
      <property>
        <name>API Key</name>
        <type>STRING</type>
        <password>true</password>
        <default/>
        <description>API key from UniFi OS: Settings, Control Plane, Integrations (requires Protect 5.3 or later, created by an administrator). Stored encrypted on the controller and cleared from this field once saved - an empty field after pasting means it was accepted.</description>
      </property>
      <property>
        <name>Verify TLS Certificate</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
        <description>Off accepts the console's self-signed certificate, which is what a console has out of the box. Turn On only if the console presents a certificate this controller can verify (for example a UniFi remote-access hostname).</description>
      </property>
      <property>
        <name>Device Poll Interval</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>30s</item>
          <item>1m</item>
          <item>2m</item>
          <item>5m</item>
          <item>15m</item>
        </items>
        <default>1m</default>
        <description>How often the device inventory and online/offline state are refreshed from the console. Off disables polling; Test Connection and Sync Devices Now still work.</description>
      </property>
      <property>
        <name>Snapshot Relay</name>
        <type>LIST</type>
        <items>
          <item>On</item>
          <item>Off</item>
        </items>
        <default>On</default>
        <description>Serves camera snapshots on the LAN so thumbnails and notification images work. The console's snapshot endpoint requires the API key, which Navigators cannot send; this relay fetches with the key and serves the image plainly at http://controller:port/snapshot/camera-id. Exposes on the LAN exactly what Protect's own Anonymous Snapshot option would.</description>
      </property>
      <property>
        <name>Relay Port</name>
        <type>STRING</type>
        <default>47800</default>
        <description>Controller port the snapshot relay listens on.</description>
      </property>
      <property>
        <name>Relay Address</name>
        <type>STRING</type>
        <default>auto</default>
        <description>The address written into published snapshot URLs. auto detects the controller's LAN IP from the project; set it explicitly if Relay Status says it could not.</description>
      </property>
      <property>
        <name>Relay Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Off</default>
      </property>
      <property>
        <name>Status</name>
        <type>LABEL</type>
        <default>Status</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Starting</default>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
        <description>The build actually running on this instance. If this does not match the newest build after an update, the project is serving a cached copy of the driver.</description>
      </property>
      <property>
        <name>Connection Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not configured - set the Console Address and API Key</default>
      </property>
      <property>
        <name>Protect Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>NVR Name</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Cameras</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Lights</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Sensors</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Chimes</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Viewers</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Arm Mode</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
        <description>Protect's alarm state, as the console reports it. Also in the ARM_MODE variable for programming.</description>
      </property>
      <property>
        <name>Arm Profile</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Offline Devices</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Last Event</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
        <description>The most recent event off the console's live stream, of any type.</description>
      </property>
      <property>
        <name>Webhook Token</name>
        <type>STRING</type>
        <default></default>
        <description>Shared secret for inbound webhooks from Protect's Alarm Manager. Webhook URL shape: http://controller:relay-port/webhook/NAME?token=TOKEN. Empty disables inbound webhooks. Generated automatically on first start if left empty.</description>
      </property>
      <property>
        <name>License Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Authorized - Licensing Not Yet Enforced</default>
        <description>This driver's entitlement, answered by the SmartBuildOS Agent (the SmartBuildOS Connector driver) in this project. Legacy mode operates normally while the licensing backend rolls out.</description>
      </property>
      <property>
        <name>SmartBuildOS Reporting</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
        <description>Hands the Protect device roster (names, MACs, online state) to the SmartBuildOS Connector in this project, so cameras join the property's equipment registry and offline cameras can raise service tickets.</description>
      </property>
      <property>
        <name>Last Sync</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Never</default>
      </property>
      <property>
        <name>Event Stream</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Off</default>
        <description>Live connection to the console's event stream - motion, smart detections, doorbell rings. Reconnects automatically if the console restarts.</description>
      </property>
      <property>
        <name>Logging</name>
        <type>LABEL</type>
        <default>Logging</default>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
        <default>Off</default>
      </property>
    </properties>
    <commands>
      <command>
        <name>Arm With Profile</name>
        <description>Arm Protect, optionally selecting profile PROFILE first</description>
        <params>
          <param><name>Profile</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Disarm</name>
        <description>Disarm Protect</description>
      </command>
      <command>
        <name>Select Arm Profile</name>
        <description>Select Protect arm profile PROFILE without arming</description>
        <params>
          <param><name>Profile</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Play Siren</name>
        <description>SECURITY - Sound Protect siren SIREN for DURATION seconds (5/10/20/30)</description>
        <params>
          <param><name>Siren</name><type>STRING</type></param>
          <param><name>Duration</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Stop Siren</name>
        <description>Stop Protect siren SIREN</description>
        <params>
          <param><name>Siren</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Test Siren</name>
        <description>Test Protect siren SIREN at VOLUME (1-100)</description>
        <params>
          <param><name>Siren</name><type>STRING</type></param>
          <param><name>Volume</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Activate Relay</name>
        <description>SECURITY - Activate Protect relay RELAY output OUTPUT (state on/off/empty=toggle, optional pulse ms)</description>
        <params>
          <param><name>Relay</name><type>STRING</type></param>
          <param><name>Output</name><type>STRING</type></param>
          <param><name>State</name><type>STRING</type></param>
          <param><name>PulseMs</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Trigger Hub Output</name>
        <description>SECURITY - Trigger Protect alarm hub HUB output OUTPUT</description>
        <params>
          <param><name>Hub</name><type>STRING</type></param>
          <param><name>Output</name><type>STRING</type></param>
          <param><name>Enable</name><type>STRING</type></param>
          <param><name>DurationMs</name><type>STRING</type></param>
        </params>
      </command>
      <command>
        <name>Trigger Protect Webhook</name>
        <description>Fire Protect Alarm Manager webhook trigger TRIGGERID</description>
        <params>
          <param><name>TriggerId</name><type>STRING</type></param>
        </params>
      </command>
    </commands>
  </config>
  <!-- No proxies: cameras appear in Navigator through the child camera driver,
       one instance per camera, attached over this driver's dynamic per-camera
       CONTROL bindings (class UNIFI_PROTECT_CAMERA, created at sync time and
       restored in OnDriverInit). -->
  <proxies/>
  <connections/>
</devicedata>
