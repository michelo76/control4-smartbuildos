  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html">Documentation</documentation>
    <actions>
      <action><name>Print Diagnostics To Log</name><command>PRINT_DIAGNOSTICS</command></action>
      <action><name>Refresh From Gateway</name><command>REFRESH_FROM_GATEWAY</command></action>
      <action><name>Forget Device</name><command>FORGET_DEVICE</command></action>
    </actions>
    <properties>
      <property>
        <name>Bond Device</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not bound</default>
        <description>Which Bond Sidekick this instance represents - bind the Bond Keypad connection to the Bond Bridge Gateway.</description>
      </property>
      <property>
        <name>Gateway Link</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Not bound - bind the Bond Keypad connection to the Gateway</default>
      </property>
      <property>
        <name>Keys</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Battery</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
        <description>Sidekick battery: OK (green), Low (replace within about a year), Critical (may fail at any time). From the Bond's coarse reporting.</description>
      </property>
      <property>
        <name>Signal</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Last Button</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>-</default>
      </property>
      <property>
        <name>Status</name>
        <type>LABEL</type>
        <default>Status</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Starting</default>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
      </property>
      <property>
        <name>Logging</name>
        <type>LABEL</type>
        <default>Logging</default>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
        <default>Off</default>
      </property>
    </properties>
  </config>
